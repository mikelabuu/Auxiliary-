# Production environment — Hostinger VPS (nginx + PHP-FPM + MySQL).
#
# Copy to .env on the server and fill in every CHANGEME. This file is a
# template and is committed; the real .env is not, and must never be.
#
# The traps that are specific to this app, in the order they bite:
#
#   1. Every VITE_* value below is compiled INTO the JavaScript bundle by
#      `npm run build`. They are not read at runtime. Set them before you
#      build, or the bundle ships with whatever was here at build time and
#      editing this file afterward changes nothing.
#   2. APP_DEBUG=true on a public host prints your database credentials on
#      any stack trace.
#   3. SESSION_SECURE_COOKIE=true requires HTTPS actually working end to end.
#      Set it after the certificate is live, or you cannot log in.

APP_NAME="Farmers Hostel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Must be https, and must match the certificate's hostname. This is what
# asset() and every mail link are built from. Getting it wrong (or leaving it
# http) breaks Alpine on every page — see the note in bootstrap/app.php.
APP_URL=https://CHANGEME.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# On in production. Unlike local, this one is load-bearing: it is the second
# factor on every staff account. It requires MAIL_* below to actually deliver —
# with a broken mailer this locks every staff member out of the console, so
# verify a real OTP arrives before you hand the system over.
STAFF_OTP_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` on a live system writes every query binding to disk, including
# whatever a guest typed into a form.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGEME
DB_USERNAME=CHANGEME
DB_PASSWORD=CHANGEME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Bare domain, no scheme, no port. Leave null unless you need the cookie
# shared across subdomains.
SESSION_DOMAIN=null
# Cookie is refused over plain HTTP once this is true. Turn it on only after
# the certificate is installed and the site loads over https.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Live push for the staff consoles. Requires the reverb systemd unit to be
# running; if it is not, App\Support\Realtime swallows the failure and the
# consoles fall back to polling rather than erroring.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database

# Real SMTP. Booking confirmations and the staff OTP both go through here, and
# both send inside the web request — a mail host that hangs is a checkout that
# hangs. Prefer a provider with a real API/relay over a personal Gmail account.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGEME
MAIL_PORT=587
MAIL_USERNAME=CHANGEME
MAIL_PASSWORD=CHANGEME
MAIL_FROM_ADDRESS="CHANGEME@CHANGEME.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Reverb ────────────────────────────────────────────────────────────────
# Two different address pairs, and mixing them up is the usual mistake:
#
#   REVERB_SERVER_* is where the daemon binds ON the box. Loopback, so the
#   websocket port is not reachable from the internet directly — nginx is the
#   only way in, which is what gives it TLS.
#
#   REVERB_HOST/PORT/SCHEME is what the BROWSER is told to connect to. That is
#   the public domain on 443, because the browser reaches it through nginx.
#
# Invent real secrets here — these are credentials, not placeholders, and the
# key is public (it ships in the JS bundle) while the secret must not be.
REVERB_APP_ID=CHANGEME
REVERB_APP_KEY=CHANGEME
REVERB_APP_SECRET=CHANGEME

REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081

REVERB_HOST=CHANGEME.com
REVERB_PORT=443
REVERB_SCHEME=https

# Compiled into the bundle at build time. Re-run `npm run build` after any
# change to the four lines above, or the browser keeps dialling the old host.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
