APP_NAME="Farmers Hostel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Staff login OTP step — a 6-digit code emailed after the password is accepted.
#
# Off by default so a fresh checkout can actually reach the staff console. With
# MAIL_MAILER=log (the default below) the code is never delivered to an inbox —
# it is written to storage/logs/laravel.log — so shipping this as `true` locks a
# new developer out of every staff screen on their first run.
#
# Set to true to exercise the OTP path; the code is at the bottom of
# storage/logs/laravel.log, or point MAIL_* at a real inbox first.
STAFF_OTP_ENABLED=false

# Which roles the OTP step applies to when it is enabled above. Unset means
# master_admin alone — front desk and admin sign in on password only. Roles are
# comma-separated and must match Staff::ROLES exactly; an unrecognised value
# never matches, so that role logs in WITHOUT a code.
# STAFF_OTP_ROLES=master_admin

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aux_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `log` keeps a fresh checkout self-contained: the staff consoles fall back to
# polling and nothing breaks. Switch to `reverb` for live push, and then you
# must also run `php artisan reverb:start` (see docs/operations.md).
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Nothing in the app implements ShouldQueue today, so mail sends inline and no
# worker is required. Before queueing anything, read the queue section of
# docs/operations.md — the staff OTP travels this path.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Live push for the staff consoles. Only consulted when BROADCAST_CONNECTION is
# set to `reverb` above; the app id/key/secret are local-only credentials you
# can invent, they just have to match between the server and the VITE_ pair.
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SERVER_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

